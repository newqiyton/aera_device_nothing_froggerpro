# Battery Property
ro.charger.enable_suspend=1
ro.recovery.usb.vid=18D1
ro.recovery.usb.adb.pid=D001
ro.recovery.usb.fastboot.pid=4EE0
ro.recovery.usb.mtp.pid=4EE1
ro.recovery.usb.mtpadb.pid=4EE2

# Keymaster / Keystore
persist.sys.qseelogd=true
persist.logd.size=8M

ro.hardware.keystore=qti
ro.crypto.keymaster_version=4.1

