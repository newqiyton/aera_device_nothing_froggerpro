# Common recovery init owns g1, ADB/fastboot FunctionFS mounts and bindings.
# Select configfs before its fs actions, rather than setting it midway through
# gadget creation. The fallback is the controller confirmed by FroggerPro logs.
on early-init
    setprop sys.usb.configfs 1

on init
    setprop sys.usb.controller ${ro.boot.usbcontroller:-a600000.dwc3}
    # Preserve the existing recovery role setup, but do it before any bind.
    # In the tester log the DWC3 child registered after this mode write.
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${sys.usb.controller} 2

# Add only the MTP function missing from common recovery init. Do not remount
# configfs, recreate g1, or mount ADB/fastboot FunctionFS a second time.
on fs
    write /config/usb_gadget/g1/bcdUSB 0x0200
    write /config/usb_gadget/g1/os_desc/use 1
    write /config/usb_gadget/g1/os_desc/b_vendor_code 0x1
    write /config/usb_gadget/g1/os_desc/qw_sign "MSFT100"
    symlink /config/usb_gadget/g1/configs/b.1 /config/usb_gadget/g1/os_desc/b.1
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /dev/usb-ffs/mtp 0770 shell system
    mount functionfs mtp /dev/usb-ffs/mtp uid=1024,gid=1024,rmode=0770,fmode=0660,no_disconnect=1
    setprop sys.usb.mtp.device_type 3
    setprop sys.usb.mtp.batchcancel 1

on property:init.svc.adbd=stopped
    setprop sys.usb.ffs.ready 0

# Common init unbinds UDC, stops the daemons, resets ADB readiness, removes f1
# and publishes state=none. Only clear the extra MTP state and links here.
on property:sys.usb.config=none && property:sys.usb.configfs=1
    setprop sys.usb.ffs.mtp.ready 0
    write /config/usb_gadget/g1/bDeviceClass 0
    write /config/usb_gadget/g1/bDeviceSubClass 0
    write /config/usb_gadget/g1/bDeviceProtocol 0
    rm /config/usb_gadget/g1/configs/b.1/f2
    rm /config/usb_gadget/g1/configs/b.1/f3

on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    start adbd

# Do not bind until every FunctionFS function in the selected configuration
# has published its descriptors. Common init handles adb/sideload/fastboot.
on property:sys.usb.config=mtp && property:sys.usb.ffs.mtp.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp"
    write /config/usb_gadget/g1/idProduct 0x${ro.recovery.usb.mtp.pid}
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=mtp,adb && property:sys.usb.ffs.mtp.ready=1 && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    write /config/usb_gadget/g1/idProduct 0x${ro.recovery.usb.mtpadb.pid}
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}
