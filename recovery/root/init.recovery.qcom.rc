import /init.recovery.encryption.rc
import /init.recovery.wifi.rc

# Set SELinux to Permissive
on early-init
    loglevel 7
    write /sys/fs/selinux/enforce 0

on early-init
    # UFS Tuning (taken from asteroids)
    write /sys/bus/platform/devices/1d84000.ufshc/auto_hibern8 0
    write /sys/bus/platform/devices/1d84000.ufshc/clkgate_enable 0
    write /sys/bus/platform/devices/1d84000.ufshc/enable_wb_buf_flush 0

on init
    start vendor.boot-qti

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

    # Make ADSP load from /firmware
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1

    # Mount firmware - Needed for ADSP firmwares
    mkdir /firmware
    mount vfat /dev/block/by-name/modem${ro.boot.slot_suffix} /firmware ro

    # Mount persist - Needed for haptics
    # We want to load this BEFORE "twrp.modules.loaded=true"
    mkdir /mnt/vendor/persist/
    mount ext4 /dev/block/bootdevice/by-name/persist /mnt/vendor/persist/ ro

on property:twrp.modules.loaded=true
    # Load ADSP firmware for PMIC
    wait /sys/kernel/boot_adsp/boot
    write /sys/kernel/boot_adsp/boot 1

    # Fixes Battery Percentage and USB-OTG
    write /sys/class/remoteproc/remoteproc1/state start

    wait /sys/class/power_supply/battery
    
    # Load haptic kernel modules (smem should be loaded by TW_LOAD_VENDOR_MODULES)
    insmod /lib/modules/haptic.ko
    insmod /lib/modules/hapticdrv.ko

    # Wait for haptic devices to be created
    wait /sys/class/leds/vibrator_nt/activate 2

    # Haptic permissions
    chmod 0666 /dev/aw86927_haptic
    chown system system /dev/aw86927_haptic
    chmod 0666 /proc/haptic/f0
    chown system system /proc/haptic/f0
    chmod 0666 /proc/haptic/lra_resistance
    chown system system /proc/haptic/lra_resistance
    chmod 0666 /proc/haptic/gpp
    chown system system /proc/haptic/gpp
    chmod 0666 /sys/class/leds/vibrator_nt/activate
    chmod 0666 /sys/class/leds/vibrator_nt/duration
    chmod 0666 /sys/class/leds/vibrator_nt/brightness
    chmod 0666 /sys/class/leds/vibrator_nt/gain
    chmod 0666 /sys/class/leds/vibrator_nt/play
    chmod 0666 /sys/class/leds/vibrator_nt/rtp
    chmod 0666 /sys/class/leds/vibrator_nt/state
    chmod 0666 /sys/class/leds/vibrator_nt/stream_start
    chmod 0666 /sys/class/leds/vibrator_nt/stream_data
    chmod 0666 /sys/class/leds/vibrator_nt/f0
    chmod 0666 /sys/class/leds/vibrator_nt/f0_en
    chmod 0666 /sys/class/leds/vibrator_nt/vbst
    chmod 0666 /sys/class/leds/vibrator_nt/brake_en
    chmod 0666 /sys/class/leds/vibrator_nt/daq_en
    chmod 0666 /sys/class/leds/vibrator_nt/daq_duration
    chmod 0666 /sys/class/leds/vibrator_nt/daq_data
    chmod 0666 /sys/class/leds/vibrator_nt/adc_offset
    chmod 0666 /sys/class/leds/vibrator_nt/lk_f0
    chmod 0666 /sys/class/leds/vibrator_nt/chip_id
    chown system system /sys/class/leds/vibrator_nt/activate
    chown system system /sys/class/leds/vibrator_nt/duration

    start health-hal-2-1
    start vendor.qti.vibrator


    # Unmount /firmware

# Run adb daemon (its not lauching for some reason)
on boot
    setprop sys.usb.config adb

on property:sys.usb.config=adb
    start adbd

# AERA configurations

service aera-pd-mapper /vendor/bin/aera-pd-mapper
    class core
    disabled
    seclabel u:r:recovery:s0
    user system
    group system
    setenv LD_LIBRARY_PATH /vendor/aera-audio-abi:/vendor/aera-stock-lib64:/vendor/lib64:/system/lib64

service aera-dspservice /vendor/bin/aera-dspservice
    class hal
    disabled
    seclabel u:r:recovery:s0
    user system
    group system wakelock oem_2908
    capabilities BLOCK_SUSPEND
    setenv LD_LIBRARY_PATH /vendor/aera-audio-abi:/vendor/aera-stock-lib64:/vendor/lib64:/system/lib64
    interface aidl vendor.qti.hardware.dsp.IDspService/default

service aera-audioadsprpcd /vendor/bin/aera-audioadsprpcd audiopd adsp
    class main
    disabled
    seclabel u:r:recovery:s0
    user media
    group media
    setenv LD_LIBRARY_PATH /vendor/aera-audio-abi:/vendor/aera-stock-lib64:/vendor/lib64:/system/lib64

# Keep AGM in its own init process group. A child forked by the one-shot
# bootstrap would be killed automatically as soon as that bootstrap exits.
service aera-agm-service /system/bin/aera-audio-service --dodge-stock-agm
    class main
    disabled
    seclabel u:r:recovery:s0
    user root
    group root system audio media wakelock
    setenv LD_LIBRARY_PATH /vendor/aera-audio-abi:/vendor/aera-stock-lib64:/vendor/lib64:/system/lib64
    setenv ANDROID_ROOT /system
    setenv ANDROID_DATA /data
    interface aidl vendor.qti.hardware.agm.IAGM/default
    interface aidl vendor.qti.hardware.pal.IPAL/default

# Start the audio DSP while SPF's deferred-probe window is still open. The
# browser bridge may invoke the same idempotent bootstrap later; it will wait
# for this instance or reuse the running AGM service.
service aera-audio-bootstrap /system/bin/aera-audio-bootstrap
    class core
    disabled
    oneshot
    seclabel u:r:recovery:s0
    user root
    group root system audio media wakelock
